# ICCS 개발계 DB/Redis + 사내 GPU(vLLM/TEI) 설정. 이 파일을 .env로 복사해 사용.
# dev(개발계) 환경 — 네이버 클라우드 VPC DB 사용
# 사용: 앱 기동 시 이 파일을 .env로 복사하거나, 로더가 .env.dev를 읽도록 지정.
# 주의: VPC DB/사내 서비스는 VPN(사내망) 연결 상태에서만 접근됨.

# ---- application ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- database (PostgreSQL + pgvector, NCP VPC) ----
# 형식: postgresql+asyncpg://<user>:<pw>@<host>:<port>/<db>
# 개발계 DB — 비밀번호는 담당자에게 문의 (git에 실제 비번 커밋 금지)
DATABASE_URL=postgresql+asyncpg://cc_app_user:<비밀번호_담당자문의>@pg-nsvul.vpc-cdb-kr.ntruss.com:15432/cc_postgre
# 앱이 cc_kms_test 스키마를 보게 하려면 접속 계정 search_path 지정 필요.
# 권장: 마스터에서 → ALTER ROLE cc_app_user SET search_path TO cc_kms_test, public;

# ---- redis (문서 역인덱스 · 동시성 제한 · arq 워커 큐, NCP VPC) ----
REDIS_URL=redis://redisc-2vbuqq.vpc-cdb.ntruss.com:16379/0

# ---- tenant ----
DEFAULT_TENANT_ID=demo

# ---- vLLM (OpenAI 호환 API, 사내 GPU worker15) ----
VLLM_BASE_URL=http://10.1.32.15:38888/v1
VLLM_MODEL=Qwen/Qwen3-14B

# ---- TEI (임베딩 / 리랭커 서버) ----
EMBED_BASE_URL=http://10.1.32.15:38889
RERANK_BASE_URL=http://10.1.32.15:38890

# ---- LLM/평가용 키 (RAGAS 평가 시에만 필요, BE 기동만이면 비워둠) ----
OPENAI_API_KEY=
GOOGLE_API_KEY=
