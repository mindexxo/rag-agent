# .env 템플릿 — 복사해서 .env로 만들고 환경에 맞게 채우세요.
# 실제 .env는 .gitignore로 제외됩니다 (키·접속정보 커밋 금지).

# ---- application ----
APP_ENV=local              # local | dev | prod
LOG_LEVEL=INFO

# ---- database (PostgreSQL + pgvector) ----
# 형식: postgresql+asyncpg://<user>@<host>:<port>/<db>
DATABASE_URL=
# 커넥션 search_path (선택) — 앱이 쓸 스키마. 기본값 cc_kms_test,cdb_admin,public.
# 다른 스키마/환경이면 오버라이드. (vector 타입이 있는 스키마를 반드시 포함할 것)
# DB_SEARCH_PATH=cc_kms_test,cdb_admin,public

# ---- redis (문서 역인덱스 · 동시성 제한 · arq 워커 큐) ----
REDIS_URL=

# ---- tenant ----
DEFAULT_TENANT_ID=demo

# ---- vLLM (OpenAI 호환 API) ----
LLM_PROVIDER=vllm          # 공급자 이름(#287) — rag/llm 등록부에 있는 것만. 옛 VLLM_* 이름은 기동 시 거부된다
LLM_BASE_URL=              # 예: http://<host>:<port>/v1
LLM_MODEL=
# LLM_API_KEY=             # 사내 vLLM은 불필요(기본 EMPTY). 상용 벤더 키는 여기(.env)에만
# 상용 예 (#288): LLM_PROVIDER=gemini LLM_MODEL=gemini-2.5-flash / LLM_PROVIDER=openai LLM_MODEL=gpt-5-mini /
#               LLM_PROVIDER=anthropic LLM_MODEL=claude-sonnet-5 — LLM_BASE_URL은 무시된다.
#               gpt-5·claude 5 계열은 LLM_TEMPERATURE=1.0 필수(기본 0.2는 vLLM용 — 사전 거부됨, 라이브 실측 10/24)
# LLM_REASONING_EFFORT=    # none|minimal|low|medium|high (미설정 = 끔). 벤더별 변환·금지 조합은 config.py 주석

# ---- TEI (임베딩 / 리랭커 서버) ----
EMBED_BASE_URL=
RERANK_BASE_URL=

# ---- LLM/평가용 키 (커밋 금지) ----
# OPENAI_API_KEY는 RAGAS 평가에서만 사용 — 개발계 BE 기동만이면 비워도 됨.
OPENAI_API_KEY=
GOOGLE_API_KEY=
