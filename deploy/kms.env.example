# KMS 운영 설정 틀 — 서버의 /app/isac-cc-application/backend/kms/kms.env로 복사해 값을 채운다(저장소에는 값을 두지 않는다).
# 빈 값(KEY=)은 필수 키다 — 비워 두면 기본값이 아니라 빈 문자열이 들어가 기동이나 연결이 실패한다.
# 주석(# KEY=)은 선택 키다 — 기본값을 바꿀 때만 주석을 풀고 값을 채운다.
# 이미지에는 개발계 설정(.env.dev)이 없다. 키를 통째로 빠뜨리면 config.py 기본값(localhost 등)으로 가서 연결 실패로 드러난다.
# 각 키의 의미·근거는 config.py 주석이 정본이다. BLOB_STORAGE_DIR·TZ는 compose가 고정하므로 여기 두지 않는다.

# ---- DB (ICCS DB) ----
DATABASE_URL=
# 앱 쿼리는 스키마를 적지 않는다 — KMS 테이블 스키마와 vector 확장이 설치된 스키마를 순서대로
DB_SEARCH_PATH=
# API 2대 + 워커 합계가 DB max_connections 여유 안에 들어야 한다(기본 50 + overflow 50 — 프로세스당)
# DB_POOL_SIZE=
# DB_MAX_OVERFLOW=

# ---- Redis (ICCS Redis) — ICCS와 다른 DB 번호를 쓴다 ----
REDIS_URL=

# ---- OpenSearch ----
OPENSEARCH_URL=

# ---- 생성·보조 LLM (상용) ----
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# 의도 분류·질의 재작성·캐시 판정용 하위 모델. 비우면 LLM_MODEL
# LLM_AUX_MODEL=

# ---- 임베딩·리랭커 (상용 — 바꾸면 전체 재색인) ----
EMBED_PROVIDER=
EMBED_MODEL=
EMBED_API_KEY=
RERANK_PROVIDER=
RERANK_MODEL=
RERANK_API_KEY=

# ---- 그림 캡션·OCR (상용 멀티모달 LLM) ----
OCR_PROVIDER=llm
# base가 아니라 전체 엔드포인트(/v1/chat/completions까지)
VLM_CAPTION_URL=
VLM_CAPTION_MODEL=
VLM_CAPTION_API_KEY=

# ---- 선택 ----
# OTel 트레이싱 수집 주소. 비우면 끈다
# OTEL_ENDPOINT=
