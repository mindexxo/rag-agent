# docling KserveV2OcrOptions가 기대하는 계약 그대로 (docling/models/stages/ocr/kserve_v2_ocr_model.py 2.126.0).
#  - 입력: lang_type (1,1) BYTES, image (1,H,W,3) UINT8 RGB — 클라이언트가 배치 차원을 붙여 보낸다.
#  - 출력: boxes (N,4,2) FP32, txts (N) BYTES, scores (N) FP32 — 클라이언트가 zip(boxes,txts,scores)로
#    돌므로 출력에는 배치 차원이 있으면 안 된다. 그래서 max_batch_size=0(배치 비활성)이고 입력 dims에
#    배치 차원 1을 명시한다.
# Python backend는 KIND_CPU로 두고 GPU 사용 여부는 아래 parameters/환경변수가 정한다 — 컨테이너에
# `--gpus device=N`으로 GPU 하나만 보이게 띄우므로 onnxruntime device_id는 항상 0이다.
name: "ocr"
backend: "python"
max_batch_size: 0

input [
  { name: "lang_type", data_type: TYPE_STRING, dims: [ 1, 1 ] },
  { name: "image",     data_type: TYPE_UINT8,  dims: [ 1, -1, -1, 3 ] }
]
output [
  { name: "boxes",  data_type: TYPE_FP32,   dims: [ -1, 4, 2 ] },
  { name: "txts",   data_type: TYPE_STRING, dims: [ -1 ] },
  { name: "scores", data_type: TYPE_FP32,   dims: [ -1 ] }
]

instance_group [ { kind: KIND_CPU, count: 1 } ]

parameters [
  # 쉼표 구분. 기동 시 언어별 엔진을 미리 올린다. 요청의 lang_type이 여기 없으면 오류 응답.
  { key: "langs",     value: { string_value: "korean" } },
  # 환경변수 TRITON_OCR_USE_CUDA가 있으면 그 값이 우선한다(로컬 CPU 검증용).
  { key: "use_cuda",  value: { string_value: "true" } },
  { key: "text_score", value: { string_value: "0.5" } }
]
